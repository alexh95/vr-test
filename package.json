{
  "name": "vr-test",
  "private": true,
  "version": "0.1.0",
  "description": "Skyreach: a browser VR playground (WebXR + three.js + Rapier) for testing on the Steam Frame",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host --mode lan",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@iwer/devui": "2.6.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "iwer": "2.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
